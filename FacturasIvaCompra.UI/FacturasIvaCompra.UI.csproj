<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FacturasIvaCompra.Application\FacturasIvaCompra.Application.csproj" />
    <ProjectReference Include="..\FacturasIvaCompra.Infrastructure\FacturasIvaCompra.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FacturasIvaCompra</AssemblyName>
    <Product>Facturas IVA Compra</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    Tesseract.dll usa InteropDotNet.LibraryLoader, que resuelve sus DLLs nativas
    (leptonica/tesseract50) a partir de Assembly.Location del propio Tesseract.dll.
    En PublishSingleFile los ensamblados embebidos reportan Location vacío, lo que
    revienta ese loader con ArgumentNullException. Se excluye del bundle para que
    quede como archivo físico en disco y Location siga siendo válido.
  -->
  <Target Name="ExcludeTesseractFromSingleFile" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_TesseractFileToUnbundle Include="@(FilesToBundle)" Condition="'%(FileName)' == 'Tesseract'" />
      <FilesToBundle Remove="@(_TesseractFileToUnbundle)" />
    </ItemGroup>
    <Copy SourceFiles="@(_TesseractFileToUnbundle)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
